# DeviceLens — Environment Variables
# Copy this file to .env.local and fill in your values

# Google Gemini API key (console.cloud.google.com)
VITE_GEMINI_API_KEY=

# Supabase project URL and anon key (supabase.com/dashboard)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Places API keys (console.cloud.google.com — enable Places API)
VITE_GOOGLE_PLACES_API_KEY_1=
VITE_GOOGLE_PLACES_API_KEY_2=
