# DeviceLens environment variables
#
# Server-only secrets for Vercel Functions.
# Do NOT prefix these with VITE_ and do not commit real values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_PLACES_API_KEY=
YOUTUBE_API_KEY=

# Optional Supabase cloud sync / Google sign-in.
# These are publishable browser configuration values, not service-role secrets.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
